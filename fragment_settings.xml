<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_placeholder">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_fastapi"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/et_fastapi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_fastapi"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_novnc"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/et_novnc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_novnc"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_quality"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <RadioGroup
            android:id="@+id/rg_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <RadioButton
                android:id="@+id/rb_quality_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quality_low" />

            <RadioButton
                android:id="@+id/rb_quality_standard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:checked="true"
                android:text="@string/quality_standard" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="提示：手机和电脑连同一个 WiFi，FastAPI/noVNC 地址填电脑的内网 IP（形如 192.168.x.x）。外网穿透见配套文档。"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</ScrollView>
